PORT=3000
HOST=127.0.0.1
JWT_SECRET=replace-with-a-32-character-minimum-development-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-an-independent-32-character-minimum-key
NODE_ENV=development
DATA_STORE=postgres
POSTGRES_PASSWORD=choose-a-strong-local-development-password
DATABASE_URL=postgresql://cascadia:choose-a-strong-local-development-password@127.0.0.1:5432/cascadia
PUBLIC_APP_URL=http://127.0.0.1:5173
# Configure all three values to enable OpenID Connect SSO locally. They are mandatory in production.
# OIDC_ISSUER_URL=https://identity.example.com/
# OIDC_CLIENT_ID=cascadia-web
# OIDC_CLIENT_SECRET=replace-with-provider-client-secret
OIDC_MFA_AMR_VALUES=mfa,otp,hwk,fido,webauthn
# Provider-specific assurance classes may be listed as a comma-separated alternative to AMR.
OIDC_MFA_ACR_VALUES=
SESSION_TTL_MINUTES=480
OBSERVABILITY_TOKEN=replace-with-a-dedicated-32-character-monitoring-secret
# Optional: server-side destination for manually requested notifications. Never expose this URL in the web app.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_PROVIDER=generic
REQUESTS_PER_MINUTE=300
SERVE_WEB=false
WEB_DIST_DIR=apps/web/dist
TRUST_PROXY_HOPS=0
